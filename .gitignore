# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─────────────────────────────────────────────────────────────────────────────
#  BACKEND (Java / Maven / Spring Boot)
# ─────────────────────────────────────────────────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.log
backend/logs/

# Maven wrapper (keep the script, ignore the binary)
!backend/.mvn/wrapper/maven-wrapper.properties

# Spring Boot dev tools restart file
backend/.spring-boot-devtools.properties

# ─────────────────────────────────────────────────────────────────────────────
#  FRONTEND (Node / Vite / React)
# ─────────────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.vercel/

# Local env overrides (keep .env.example committed)
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ─────────────────────────────────────────────────────────────────────────────
#  Logs
# ─────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
