# Set these in Render → Environment Variables

# PostgreSQL — paste Render's "Internal Database URL" exactly as-is
# Render gives:  postgres://user:pass@host:5432/dbname
# The app converts it to jdbc:postgresql:// automatically — no changes needed
DATABASE_URL=postgres://user:pass@host:5432/dbname

# JPA — use 'update' so data survives restarts
DDL_AUTO=update

# Dialect hint for PostgreSQL (prevents startup warning)
JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# JWT — generate a strong random string (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret-string-here

# CORS — your Vercel frontend URL (no trailing slash)
ALLOWED_ORIGINS=https://your-app-name.vercel.app

# Disable H2 console in production
ENABLE_H2_CONSOLE=false

# Logging
LOG_LEVEL=INFO

# Alpha Vantage (optional — free key at alphavantage.co)
ALPHA_VANTAGE_KEY=demo

# Mail (optional)
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
