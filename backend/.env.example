# ── Render Environment Variables ──────────────────────────────────────────────
# Set these in Render → Your Web Service → Environment

# Database — use Spring's native env var names so no code conversion is needed.
# Take Render's Internal Database URL (postgres://user:pass@host:5432/db)
# and manually change "postgres://" to "jdbc:postgresql://"
SPRING_DATASOURCE_URL=jdbc:postgresql://user:pass@host:5432/dbname
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT — any random string, 32+ chars
JWT_SECRET=replace-with-a-long-random-secret-string-here

# CORS — your Vercel frontend URL, no trailing slash
ALLOWED_ORIGINS=https://your-app-name.vercel.app

# Disable H2 console in production
ENABLE_H2_CONSOLE=false

# Logging
LOG_LEVEL=INFO

# Alpha Vantage (optional)
ALPHA_VANTAGE_KEY=demo
